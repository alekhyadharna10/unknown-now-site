---
layout: base.njk
permalink: /cohort/
title: "Cohort 2026"
description: "Meet the interns and mentors of The UnknownNow."
---
<section class="hero">
  <div class="container">
    <p class="eyebrow">{{ cohort.heroEyebrow or "The cohort" }}</p>
    <h1>{{ cohort.heroTitle or "Meet the people behind the work" }}</h1>
    <p class="lede">{{ cohort.heroLede }}</p>
    <div class="subnav">
      <a href="#program">The program</a>
      {% if cohort.interns and cohort.interns.length %}<a href="#interns">Interns</a>{% endif %}
      {% if cohort.mentors and cohort.mentors.length %}<a href="#mentors">Mentors</a>{% endif %}
      <a href="/get-involved/">How to apply</a>
    </div>
  </div>
</section>

<section id="program">
  <div class="container">
    <div class="section-head">
      <p class="kicker">{{ cohort.programKicker }}</p>
      <h2>{{ cohort.programHeading }}</h2>
    </div>
    <div class="card-grid">
      {% for pt in cohort.programPoints %}
      <div class="card">
        <h3>{{ pt.title }}</h3>
        <p>{{ pt.body }}</p>
      </div>
      {% endfor %}
    </div>
    <p style="margin-top:1.5rem;"><a href="/get-involved/">See the roles and how to apply →</a></p>
  </div>
</section>

{% if cohort.interns and cohort.interns.length %}
<section id="interns">
  <div class="container">
    <div class="section-head">
      <p class="kicker">{{ cohort.internsKicker }}</p>
      <h2>{{ cohort.internsHeading }}</h2>
      <p>{{ cohort.internsIntro }}</p>
    </div>
    <div class="people-grid">
      {% for p in cohort.interns %}
      <div class="person">
        {% if p.photo %}<img class="person-photo" src="{{ p.photo }}" alt="{{ p.name }}">{% else %}<span class="person-photo person-initial" aria-hidden="true">{{ p.name | first }}</span>{% endif %}
        <h3>{{ p.name }}</h3>
        <p>{{ p.role }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if cohort.mentors and cohort.mentors.length %}
<section id="mentors">
  <div class="container">
    <div class="section-head">
      <p class="kicker">{{ cohort.mentorsKicker }}</p>
      <h2>{{ cohort.mentorsHeading }}</h2>
      <p>{{ cohort.mentorsIntro }}</p>
    </div>
    <div class="mentor-grid">
      {% for m in cohort.mentors %}
      <div class="mentor">
        {% if m.photo %}<img class="mentor-photo" src="{{ m.photo }}" alt="{{ m.name }}">{% else %}<span class="mentor-photo person-initial" aria-hidden="true">{{ m.name | first }}</span>{% endif %}
        <h3>{{ m.name }}</h3>
        <span class="tag tag-live">{{ m.role }}</span>
        <p>{{ m.bio }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
