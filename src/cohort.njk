---
layout: base.njk
permalink: /cohort/
title: "Cohort 2026"
description: "Meet the interns and mentors of The UnknownNow."
---
{% set internList = (collections.interns | sort(false, false, "data.order")) if collections.interns else [] %}
{% set mentorList = (collections.mentors | sort(false, false, "data.order")) if collections.mentors else [] %}
<section class="hero">
  <div class="container">
    <p class="eyebrow">{{ cohort.heroEyebrow or "The cohort" }}</p>
    <h1>{{ cohort.heroTitle or "Meet the people behind the work" }}</h1>
    <p class="lede">{{ cohort.heroLede }}</p>
    <div class="subnav">
      <a href="#program">The program</a>
      {% if internList.length %}<a href="#interns">Interns</a>{% endif %}
      {% if mentorList.length %}<a href="#mentors">Mentors</a>{% endif %}
      <a href="/get-involved/">How to apply</a>
    </div>
  </div>
</section>

<section id="program">
  <div class="container">
    <div class="section-head">
      <p class="kicker">{{ cohort.programKicker }}</p>
      <h2>{{ cohort.programHeading }}</h2>
    </div>
    <div class="card-grid">
      {% for pt in cohort.programPoints %}
      <div class="card">
        <h3>{{ pt.title }}</h3>
        <p>{{ pt.body }}</p>
      </div>
      {% endfor %}
    </div>
    <p style="margin-top:1.5rem;"><a href="/get-involved/">See the roles and how to apply →</a></p>
  </div>
</section>

{% if not internList.length %}
<section>
  <div class="container">
    <p class="cohort-soon">{{ cohort.emptyNote or "Our interns will be introduced here." }}</p>
  </div>
</section>
{% endif %}

{% if internList.length %}
<section id="interns">
  <div class="container">
    <div class="section-head">
      <p class="kicker">{{ cohort.internsKicker }}</p>
      <h2>{{ cohort.internsHeading }}</h2>
      <p>{{ cohort.internsIntro }}</p>
    </div>
    <div class="people-grid">
      {% for item in internList %}
      <div class="person">
        {% if item.data.photo %}<img class="person-photo" src="{{ item.data.photo }}" alt="{{ item.data.name }}">{% else %}<span class="person-photo person-initial" aria-hidden="true">{{ item.data.name | first }}</span>{% endif %}
        <h3>{{ item.data.name }}</h3>
        <p>{{ item.data.role }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if mentorList.length %}
<section id="mentors">
  <div class="container">
    <div class="section-head">
      <p class="kicker">{{ cohort.mentorsKicker }}</p>
      <h2>{{ cohort.mentorsHeading }}</h2>
      <p>{{ cohort.mentorsIntro }}</p>
    </div>
    <div class="mentor-grid">
      {% for item in mentorList %}
      <div class="mentor">
        {% if item.data.photo %}<img class="mentor-photo" src="{{ item.data.photo }}" alt="{{ item.data.name }}">{% else %}<span class="mentor-photo person-initial" aria-hidden="true">{{ item.data.name | first }}</span>{% endif %}
        <h3>{{ item.data.name }}</h3>
        <span class="tag tag-live">{{ item.data.role }}</span>
        <p>{{ item.data.bio }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
