---
layout: base.njk
permalink: /research/
title: "Research"
description: "The Unknown Brain series: literature reviews and original research on neuroscience and psychology, from The UnknownNow."
heroEyebrow: "The Unknown Brain"
heroTitle: "Our research archive"
heroLede: "Through our Student-Led Research Journal, we turn complex research into clear writing that helps the public understand advances and issues in neuroscience and psychology."
---
<section class="hero">
  <div class="container">
    <p class="eyebrow">{{ heroEyebrow }}</p>
    <h1>{{ heroTitle }}</h1>
    <p class="lede">{{ heroLede }}</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="article-list">
      {% for article in collections.research | reverse %}
      <article class="article-row">
        <div class="article-meta">{{ article.data.displayDate }}</div>
        <div class="rl-body">
          {% if article.data.image %}<a class="rl-thumb" href="{{ article.url }}" tabindex="-1" aria-hidden="true"><img src="{{ article.data.image }}" alt="" loading="lazy"></a>{% endif %}
          <div class="rl-text">
          <h3><a href="{{ article.url }}">{{ article.data.title }}</a></h3>
          <p>{{ article.data.summary }}</p>
          <a class="read-link" href="{{ article.url }}">Read the full piece →</a>
        </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
