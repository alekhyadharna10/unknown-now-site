---
layout: base.njk
permalink: /research/
title: "Research"
description: "The Unknown Brain series: literature reviews and original research on neuroscience and psychology, from The UnknownNow."
heroEyebrow: "The Unknown Brain"
heroTitle: "Our research archive"
heroLede: "Through Our Student-Led Research Journal, we have the potential to make real and positive change to advance the medical field to unimaginable lengths and to aid the public about prevalent advancements and issues."
---
<section class="hero">
  <div class="container">
    <p class="eyebrow">{{ heroEyebrow }}</p>
    <h1>{{ heroTitle }}</h1>
    <p class="lede">{{ heroLede }}</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="article-list">
      {% for article in collections.research | reverse %}
      <article class="article-row">
        <div class="article-meta">{{ article.data.displayDate }}</div>
        <div>
          <h3><a href="{{ article.url }}">{{ article.data.title }}</a></h3>
          <p>{{ article.data.summary }}</p>
          <a class="read-link" href="{{ article.url }}">Read the full piece →</a>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
