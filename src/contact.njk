---
layout: base.njk
permalink: /contact/
title: "Contact"
description: "Get in touch with The Unknown Now."
heroEyebrow: "Contact"
heroTitle: "Say hello."
heroLede: "Whether you're interested in interning, collaborating, or featuring our research — we'd like to hear from you."
---
<section class="hero">
  <div class="container">
    <p class="eyebrow">{{ heroEyebrow }}</p>
    <h1>{{ heroTitle }}</h1>
    <p class="lede">{{ heroLede }}</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="card-grid">
      <div class="card">
        <h3>Email</h3>
        <p><a href="mailto:{{ contact.email }}">{{ contact.email }}</a></p>
      </div>
      <div class="card">
        <h3>Social</h3>
        {% for s in contact.social %}
        <p><a href="{{ s.link }}">{{ s.name }}</a></p>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
