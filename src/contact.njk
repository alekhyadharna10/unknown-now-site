---
layout: base.njk
permalink: /contact/
title: "Contact"
description: "Get in touch with The UnknownNow."
heroEyebrow: "Contact"
heroTitle: "Let's talk"
heroLede: "Questions, ideas, or interested in joining the cohort? Send us a message and we'll get back to you."
---
<section class="hero">
  <div class="container">
    <p class="eyebrow">{{ heroEyebrow }}</p>
    <h1>{{ heroTitle }}</h1>
    <p class="lede">{{ heroLede }}</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <div class="contact-card c1">
          <h3>Email</h3>
          <p><a href="mailto:{{ contact.email }}">{{ contact.email }}</a></p>
        </div>
        {% for s in contact.social %}
        <div class="contact-card c2">
          <h3>{{ s.name }}</h3>
          <p><a href="{{ s.link }}" target="_blank" rel="noopener">Follow us on {{ s.name }}</a></p>
        </div>
        {% endfor %}
        <div class="contact-card c3">
          <h3>Join the cohort</h3>
          <p>Interested in becoming an intern? <a href="/get-involved/">See how to apply</a>.</p>
        </div>
      </div>

      <form class="contact-form" name="contact" method="POST" action="/contact/thanks/" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact">
        <p class="hp"><label>Leave this empty: <input name="bot-field"></label></p>
        <h2>Send us a message</h2>
        <label for="cf-name">Your name</label>
        <input id="cf-name" name="name" type="text" required autocomplete="name">
        <label for="cf-email">Your email</label>
        <input id="cf-email" name="email" type="email" required autocomplete="email">
        <label for="cf-topic">What is this about?</label>
        <select id="cf-topic" name="topic">
          <option>General question</option>
          <option>Joining the cohort</option>
          <option>Writing for the journal</option>
          <option>Collaborating with us</option>
          <option>The Sensory Audit Initiative</option>
        </select>
        <label for="cf-message">Your message</label>
        <textarea id="cf-message" name="message" rows="6" required></textarea>
        <button class="btn btn-primary" type="submit">Send message</button>
      </form>
    </div>
  </div>
</section>
