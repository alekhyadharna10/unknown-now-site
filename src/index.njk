---
layout: base.njk
permalink: /
title: "Science Communication, Grounded in Neuroscience"
description: "The UnknownNow is a student-run organization making credible neuroscience and psychology research understandable to a wider audience."
heroEyebrow: "The UnknownNow"
heroTitle: "Making real science make sense."
heroLede: "We're a student-run organization that translates credible neuroscience and psychology research into writing people actually want to read — without dumbing it down."
quote: "Science communication is the organizing idea. Neuroscience is the lens we bring to it."
pillars:
  - title: "Research & the Unknown Brain series"
    body: "A recurring series of literature reviews on the neuroscience and psychology topics we find genuinely fascinating, alongside original research and experiments aimed at earning real, citable credibility. Every piece has its own page, easy to read and share."
    link: "/research/"
    linkText: "Browse the archive"
  - title: "Mentorship & internships"
    body: "Each incoming cohort of interns is mentored directly by our founders. Interns aren't just learners. Once onboarded, they help run the organization."
    link: "/get-involved/"
    linkText: "See how to apply"
  - title: "What we're building next"
    body: "The Sensory Audit Initiative: a public audit of the sensory environments we move through every day. It's still an early concept, not yet live and not partnered with anyone. If you'd like to help shape it, get in touch."
    link: "/contact/"
    linkText: "Get in touch"
cohortTitle: "Meet the interns running it"
cohortBody: "Each cohort is mentored directly by our founders and takes on real responsibility in running The UnknownNow."
cohortRoles:
  - name: "Writers"
    body: "Turn a research paper into a clear, accurate literature review. Writers pick a topic, read the studies, and draft articles for the Unknown Brain series with an editor's feedback."
  - name: "Editors"
    body: "Check claims against their sources, tighten the writing, and make sure every article is accurate and readable before it is published."
  - name: "Designers"
    body: "Create the visuals that go with the research: graphics, layouts and social posts that make a complex idea easy to see."
  - name: "Outreach"
    body: "Grow our readership through Instagram, partnerships with other student groups, and getting the research in front of people who would want it."
---
{% set latest = collections.research | reverse | first %}
{% set recent = collections.research | reverse %}
{% set shapes = ['bl leaf1', 'bp leaf2', 'bs leaf3'] %}
{% set minis = ['bp', 'be', 'bl'] %}
<div class="hx">
<section class="hero-home">
  <span class="backblob bb1"></span><span class="backblob bb2"></span>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="plate-label fade" style="--d:0">{{ heroEyebrow }}</p>
      <h1 class="hero-title">{{ heroTitle }}</h1>
      <p class="lede fade" style="--d:450">{{ heroLede }}</p>
      <div class="hero-actions fade" style="--d:600">
        <a class="btn btn-primary" href="/research/">Read our research</a>
        <a class="btn btn-secondary" href="/get-involved/">Get involved</a>
      </div>
      {% if latest %}
      <p class="hero-latest fade" style="--d:750"><span>Newest in the archive</span> <a href="{{ latest.url }}">{{ latest.data.title }}</a> <em>{{ latest.data.displayDate }}</em></p>
      {% endif %}
    </div>
    {% include "hero-plate.njk" %}
  </div>
</section>

<section class="home-sec">
  <div class="container">
    <div class="section-head">
      <p class="kicker rv">What we do</p>
      <h2 class="split-words">Three ways into the unknown</h2>
    </div>
    <div class="layers" data-a="">
      <div class="layers-text">
        {% for p in pillars %}
        <div class="lrow" data-k="{{ loop.index0 }}" tabindex="0">
          <h3>{{ p.title }}</h3>
          <p>{{ p.body }}</p>
          <a href="{{ p.link }}">{{ p.linkText }} →</a>
        </div>
        {% endfor %}
      </div>
      <svg class="layers-svg" viewBox="0 0 560 560" aria-hidden="true">
        <g class="ly k2" data-k="2" style="--s:466.7px;--c:316px"><line x1="0" y1="0" x2="254" y2="0"/><path d="M260 0 L400 -70 L540 0 L400 70 Z"/></g>
        <g class="ly k1" data-k="1" style="--s:280px;--c:280px"><line x1="0" y1="0" x2="254" y2="0"/><path d="M260 0 L400 -70 L540 0 L400 70 Z"/></g>
        <g class="ly k0" data-k="0" style="--s:93.3px;--c:244px"><line x1="0" y1="0" x2="254" y2="0"/><path d="M260 0 L400 -70 L540 0 L400 70 Z"/></g>
      </svg>
    </div>
    <script>(function(){var L=document.querySelector('.layers');if(!L)return;
    function set(k){L.setAttribute('data-a',k)}
    L.querySelectorAll('.lrow,.ly').forEach(function(n){var k=n.getAttribute('data-k');
    n.addEventListener('mouseenter',function(){set(k)});n.addEventListener('focus',function(){set(k)});
    n.addEventListener('mouseleave',function(){set('')});n.addEventListener('blur',function(){set('')})});
    function go(){L.classList.add('in')}
    if(!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion:reduce)').matches){go();return}
    var io=new IntersectionObserver(function(e){if(e[0].isIntersecting){go();io.disconnect()}},{threshold:.35});io.observe(L);
    })();</script>
    <!-- BELIEF START --><div class="belief">
      <p class="bk">Our belief</p>
      <p class="bq">{{ quote }}</p>
      <a class="bl" href="/about/">Learn more about our mission and how we work →</a>
    </div><!-- BELIEF END -->
  </div>
</section>

<section class="home-sec" style="padding-top:40px">
  <div class="container">
    <div class="section-head">
      <p class="kicker rv">The archive</p>
      <h2 class="split-words">Newest research</h2>
    </div>
    <div class="rlist">
      {% for item in recent %}{% if loop.index < 4 %}
      <div class="rrow">
        <a class="hexwrap" href="{{ item.url }}" aria-label="{{ item.data.title }}">
          <span class="ha a1"></span><span class="ha a2"></span>
          <span class="h1"></span><span class="h2"></span>
          <img src="{{ item.data.image }}" alt="">
          <i class="nd"></i><i class="nd"></i><i class="nd"></i><i class="nd"></i><i class="nd"></i><i class="nd"></i>
        </a>
        <div class="rtext">
          <h3><a href="{{ item.url }}">{{ item.data.title }}</a></h3>
          <p class="lab">Authors</p><p class="val">{{ item.data.author }}</p>
          <p class="lab">Published</p><p class="val">{{ item.data.displayDate }}</p>
          <a class="go" href="/research/">Find out more →</a>
        </div>
      </div>
      {% endif %}{% endfor %}
      <p class="rp-all rv"><a href="/research/">See all research →</a></p>
    </div>
  </div>
</section>

<div class="wave-wrap"><svg class="wave" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true"><path fill="#39465E" d="M0 60 C 120 20 240 20 360 60 C 480 100 600 100 720 60 C 840 20 960 20 1080 60 C 1200 100 1320 100 1440 60 L1440 120 L0 120 Z"/></svg></div>

<div class="home-dark">
<section class="home-sec home-quote">
  <div class="container">
    <p class="kicker rv">Our belief</p>
    <blockquote class="split-words">{{ quote }}</blockquote>
    <p class="rv"><a href="/about/">Learn more about our mission and how we work →</a></p>
  </div>
</section>

<section class="home-sec home-cohort" id="cohort">
  <div class="container cohort-grid">
    <div>
      <p class="kicker rv">The cohort</p>
      <h2 class="split-words">{{ cohortTitle }}</h2>
      <p class="rv">{{ cohortBody }}</p>
      <p><a class="btn btn-primary pop" href="/get-involved/">Apply to the next cohort</a></p>
    </div>
    <div class="role-stack">
      {% for r in cohortRoles %}
      <div class="role r{{ loop.index }}">
        <button class="role-head" type="button" aria-expanded="false" aria-controls="role-{{ loop.index }}"><span>{{ r.name }}</span><i class="role-plus" aria-hidden="true"></i></button>
        <div class="role-body" id="role-{{ loop.index }}" role="region"><div class="role-inner"><p>{{ r.body }}</p></div></div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
</div>
</div>
