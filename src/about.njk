    </div>
    <p>{{ missionBody }}</p>
    <p>{{ missionBody2 }}</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-head">
      <p class="kicker">{{ foundersKicker }}</p>
      <h2>{{ foundersHeading }}</h2>
    </div>
    <div class="founders">
      {% for f in founders %}
      <div class="card">
        <h3>{{ f.name }}</h3>
        <p>{{ f.bio }}</p>
      </div>
      {% endfor %}
    </div>
    <p style="margin-top:1.5rem;">Each new cohort of interns is mentored directly by the two of us, and takes on real responsibility running the organization as they grow into it. <a href="/get-involved/">See the internship program →</a></p>
